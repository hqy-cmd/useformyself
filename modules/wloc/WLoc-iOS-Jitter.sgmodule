#!name=WLoc iOS Jitter 1km
#!desc=新加坡目标周围 1 公里随机抖动；每次 WLoc 请求抽样；iOS 兼容性仍待验证。

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com

[Script]
wloc-ios-jitter = type=http-request, pattern=^https://(?:gs-loc|gs-loc-cn)\.apple\.com(?::443)?/clls/wloc(?:\?|$), requires-body=true, binary-body-mode=true, max-size=1048576, timeout=5, script-path=https://raw.githubusercontent.com/hqy-cmd/useformyself/main/modules/wloc/wloc.js, argument="enabled=true&lat=1.29167&lon=103.85000&altitude=0&hacc=10&vacc=10&radiusKm=1"
